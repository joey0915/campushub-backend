# Cursor's agent ignore list: the same patterns as .ignore, which Cursor does
# not read. Keep the two files in sync (AGENTS.md §8).

# Dependencies and build output
node_modules/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
*.map

# Lockfiles: thousands of lines no task needs; use `npm ls` instead
package-lock.json

# Logs
logs/
*.log

# Historical lab logs and generated diagrams: documentation, not source
docs/lab*-steering-log.md
docs/diagrams/
client/public/
