# CampusHub client — optional overrides. Copy to `.env`; never commit `.env`.
# Without a `.env`, the defaults shown here apply.

# Origin of the backend API that the Vite dev server proxies `/api` to.
CAMPUSHUB_API_ORIGIN=http://localhost:3000

# Path prefix of the API, matching `servers[0].url` in docs/openapi.yaml.
VITE_API_BASE_PATH=/api/v1
